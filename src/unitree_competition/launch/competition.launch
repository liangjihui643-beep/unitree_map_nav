<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="mode" default="mapping" />
  <arg name="gui" default="true" />
  <arg name="rviz" default="true" />
  
  <arg name="map_file" default="$(find unitree_competition)/maps/competition.yaml" />
  <include file="$(find unitree_local_demo)/launch/demo.launch">
    <arg name="mode" value="$(arg mode)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="world_path" value="$(find unitree_competition)/worlds/competition.world" />
    <arg name="spawn_x" value="0" />
    <arg name="spawn_y" value="0" />
    <arg name="spawn_z" value="0.6" />
    <arg name="spawn_yaw" value="1.57079632679" />
  </include>
</launch>
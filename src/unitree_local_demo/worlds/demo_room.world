<?xml version="1.0"?>
<sdf version="1.6">
  <world name="demo_room">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters></solver></ode>
    </physics>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.8 0.85 0.9 1</background></scene>
    <gui><camera name="user_camera"><pose>6 -7 6 0 0.55 2.25</pose></camera></gui>
    <model name="room_walls">
      <static>true</static>
      <link name="north"><pose>0 3 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
      <link name="south"><pose>0 -3 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
      <link name="east"><pose>4 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
      <link name="west"><pose>-4 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 6 1</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="box_a"><static>true</static><pose>2 1.3 0.35 0 0 0</pose><link name="box">
      <collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.8 0.4 0.2 1</ambient></material></visual>
    </link></model>
    <model name="box_b"><static>true</static><pose>-1.5 -1.5 0.3 0 0 0.3</pose><link name="box">
      <collision name="collision"><geometry><box><size>0.8 0.6 0.6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 0.6 0.6</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
    </link></model>
  </world>
</sdf>
